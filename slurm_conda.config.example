// Nextflow config for SangerBlaster - Conda version for SLURM cluster (no containers)

params.start = new java.util.Date().format("yyyyMMdd")

// Conda settings
conda {
    enabled = true
}

// Parameters
params.samples_tsv = './samples.tsv'
params.db = ''
params.evalue = '0.1'
params.topHits = '5'
params.cpus = '8'  // Adjusted for local testing (8 CPUs available)
params.publish_dir = './'
params.ref = ''

// Executor settings (local or slurm)
executor {
    name = 'local'  // Use 'slurm' if submitting to SLURM queue
    memory = '100.GB'
}

// Process settings with resource definitions (Conda, no container)
process {
    withName: 'tracyAssemble' {
        cpus = 4
        memory = '4.GB'
        time = '60.min'
        disk = '10.GB'
    }

    withName: 'blastn' {
        cpus = 4
        memory = '8.GB'
        time = '240.min'
        disk = '50.GB'
    }

    withName: 'blastnTopHits' {
        cpus = 1
        memory = '512.MB'
        time = '2.min'
        disk = '5.GB'
    }

    withName: 'blastHits_concat' {
        cpus = 1
        memory = '512.MB'
        time = '2.min'
        disk = '5.GB'
    }
}

// Container engine disabled - using Conda instead
docker {
    enabled = false
}

singularity {
    enabled = false
}
