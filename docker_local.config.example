// Nextflow config for GenoSanger - Updated for 26.x

params.start = new java.util.Date().format("yyyyMMdd")
params.threads = Runtime.getRuntime().availableProcessors()

// Conda settings (optional)
conda {
    enabled = true
}

// Parameters
params.samples_tsv = './samples.tsv'
params.db = ''
params.evalue = '0.1'
params.topHits = '5'
params.cpus = '18'
params.publish_dir = './'
params.ref = ''

// Executor settings (local for testing, change to slurm for cluster)
executor {
    name = 'local'
    cpus = params.threads
    memory = '16.GB'
}

// Process settings with resource definitions
process {
    withName: 'tracyAssemble' {
        container = 'quay.io/nf-core/ubuntu:20.04'
        cpus = 4
        memory = '4.GB'
        time = '60.min'
        disk = '10.GB'
    }

    withName: 'blastn' {
        container = 'quay.io/biocontainers/blast:2.14.1--pl5321h6f7f691_0'
        cpus = 18
        memory = '8.GB'
        time = '240.min'
        disk = '50.GB'
    }

    withName: 'blastnTopHits' {
        container = 'quay.io/nf-core/ubuntu:20.04'
        cpus = 1
        memory = '512.MB'
        time = '2.min'
        disk = '5.GB'
    }

    withName: 'blastHits_concat' {
        container = 'quay.io/nf-core/ubuntu:20.04'
        cpus = 1
        memory = '512.MB'
        time = '2.min'
        disk = '5.GB'
    }
}

// Container engine settings
singularity {
    enabled = false  // Disable for now - use Docker instead
}

docker {
    enabled = true
}
